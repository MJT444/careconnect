                "_id",
                "created_at",
                "location",
                "nurse_id",
                "status"
            ],
            "properties": {
                "_id": {
                    "bsonType": "objectId"
                },
                "created_at": {
                    "bsonType": "date"
                },
                "location": {
                    "bsonType": "object",
                    "properties": {
                        "coordinates": {
                            "bsonType": "array",
                            "items": {
